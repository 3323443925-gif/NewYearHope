# =========================================================
# Starlight Isle (星屿祈光) Environment Configuration
# Copy to .env.local for local overrides.
# By default (with no env vars), the app runs locally using
# Node built-in SQLite + local disk uploads + built-in safety.
# =========================================================

# Public site URL (used for OpenGraph metadata)
NEXT_PUBLIC_SITE_URL=https://idnenz.cn

# Data provider: "sqlite" (default for local dev) | "supabase" (production)
DATA_PROVIDER=sqlite

# Storage provider: "local" (default for local dev) | "supabase" (production)
STORAGE_PROVIDER=local

# Admin panel access token (change to a strong random string in production!)
ADMIN_TOKEN=starlight-admin-dev

# Salt for hashing IPs and reporter fingerprints (change in production!)
HASH_SALT=starlight-isle-default-salt

# ---------------- Supabase (Production) ----------------
# IMPORTANT: Only used on the server (never exposed to browser),
# ensuring mainland China users never connect directly to *.supabase.co.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lantern-images

# ---------------- Pluggable Cloud Moderation (Optional) ----------------
# Built-in bilingual filter + crisis helpline detection is ALWAYS enabled.
# Optionally add OpenAI Moderation API key for cloud text/image safety checks.
OPENAI_API_KEY=
OPENAI_MODERATION_BASE_URL=https://api.openai.com/v1
